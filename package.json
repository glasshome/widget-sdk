{
  "name": "@glasshome/widget-sdk",
  "version": "1.22.1",
  "description": "SDK for building GlassHome dashboard widgets with SolidJS",
  "keywords": [
    "dashboard",
    "glasshome",
    "home-assistant",
    "sdk",
    "smart-home",
    "solidjs",
    "vite",
    "widget"
  ],
  "homepage": "https://github.com/glasshome/widget-sdk#readme",
  "bugs": {
    "url": "https://github.com/glasshome/widget-sdk/issues"
  },
  "license": "MIT",
  "author": "GlassHome",
  "repository": {
    "type": "git",
    "url": "https://github.com/glasshome/widget-sdk.git"
  },
  "files": [
    "dist",
    "preview",
    "tailwind-sources.css",
    "guide"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "@glasshome/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./schemas": {
      "@glasshome/source": "./src/schemas.ts",
      "types": "./dist/schemas.d.ts",
      "import": "./dist/schemas.js"
    },
    "./deprecations": {
      "@glasshome/source": "./src/deprecations.ts",
      "types": "./dist/deprecations.d.ts",
      "import": "./dist/deprecations.js"
    },
    "./host": {
      "@glasshome/source": "./src/host/index.ts",
      "types": "./dist/host/index.d.ts",
      "import": "./dist/host/index.js"
    },
    "./vite": {
      "@glasshome/source": "./src/vite/index.ts",
      "types": "./dist/vite/index.d.ts",
      "import": "./dist/vite/index.js"
    },
    "./tailwind-sources": "./tailwind-sources.css",
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "vite build && tsc && bun scripts/check-host-singleton.ts",
    "dev": "vite build --watch",
    "test": "bun test src && vitest run",
    "test:dom": "vitest run",
    "test:dom:watch": "vitest",
    "typecheck:test": "tsc --noEmit -p tsconfig.test.json",
    "check:dead": "fallow dead-code --fail-on-issues",
    "lint": "oxlint --type-aware . && oxfmt --check ."
  },
  "dependencies": {
    "@glasshome/widget-contract": "0.3.0",
    "@tailwindcss/vite": "^4.1.13",
    "clsx": "^2.1.1",
    "happy-dom": "^20.0.0",
    "lightningcss": "^1.33.0",
    "tailwind-merge": "^3.5.0",
    "tailwindcss": "^4.1.13",
    "zod": "^4.1.13"
  },
  "devDependencies": {
    "@glasshome/ui": "1.28.0",
    "@solidjs/testing-library": "^0.8.10",
    "@types/bun": "^1.4.0",
    "@types/node": "^25.2.2",
    "fallow": "3.17.0",
    "oxfmt": "0.65.0",
    "oxlint": "1.81.0",
    "oxlint-tsgolint": "7.0.2001",
    "typescript": "^7.0.2",
    "vite": "^8.1.0",
    "vite-plugin-solid": "^2.11.12",
    "vitest": "^4.1.10"
  },
  "peerDependencies": {
    "@glasshome/sync-layer": "0.9.1",
    "@glasshome/ui": "1.28.0",
    "solid-js": "^1.9.11"
  },
  "engines": {
    "node": ">=18"
  }
}
